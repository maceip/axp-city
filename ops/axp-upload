#!/usr/bin/env python3
"""Bounded, atomic archive receiver for the unprivileged AXP deploy user."""
from __future__ import annotations

import os
from pathlib import Path
import re
import sys
import tempfile

INCOMING = Path("/var/lib/axp-deploy/incoming")
MAX_BYTES = 512 * 1024 * 1024
SHA = re.compile(r"[0-9a-f]{40}")


def main() -> int:
    if len(sys.argv) != 2 or not SHA.fullmatch(sys.argv[1]):
        raise SystemExit("axp-upload: invalid revision")
    revision = sys.argv[1]
    destination = INCOMING / f"{revision}.tar.gz"
    if destination.exists():
        raise SystemExit("axp-upload: archive already exists")

    fd, temporary_name = tempfile.mkstemp(prefix=f".{revision}.", dir=INCOMING)
    temporary = Path(temporary_name)
    total = 0
    try:
        with os.fdopen(fd, "wb") as output:
            os.fchmod(output.fileno(), 0o600)
            while True:
                block = sys.stdin.buffer.read(1024 * 1024)
                if not block:
                    break
                total += len(block)
                if total > MAX_BYTES:
                    raise RuntimeError("archive exceeds 512 MiB")
                output.write(block)
            if total == 0:
                raise RuntimeError("empty archive")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, destination)
        directory = os.open(INCOMING, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except Exception:
        temporary.unlink(missing_ok=True)
        raise
    print(f"uploaded {revision} ({total} bytes)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
